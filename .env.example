# DocMind 环境配置示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿将真实密钥提交到仓库

# ===== 必需 =====
# DeepSeek API 密钥（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-api-key-here

# ===== 可选（下方为默认值，取消注释即可覆盖） =====
# DeepSeek 接口地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 视觉抽取模型（DeepSeek V4.1 Flash 的规范模型 ID）
# DEEPSEEK_MODEL=deepseek-flash

# 采样温度（抽取场景建议 0.0）
# DEEPSEEK_TEMPERATURE=0.0

# 单次请求超时（秒）
# DEEPSEEK_TIMEOUT_SECONDS=240.0

# 请求失败重试次数
# DEEPSEEK_MAX_RETRIES=1

# 运行数据根目录（上传文件、任务产物、分析结果）
# DOCMIND_DATA_ROOT=data

# ===== 系统日志 =====
# 系统日志文件（应用日志与 Uvicorn 访问日志）
# DOCMIND_SYSTEM_LOG_FILE=logs/app.log

# 系统日志等级
# DOCMIND_SYSTEM_LOG_LEVEL=INFO

# 系统日志按日轮转后的保留天数
# DOCMIND_SYSTEM_LOG_RETENTION_DAYS=14

# ===== 港口三字码归一化 =====
# poOrder PublicWebApi 根地址（如 http://<host>/PublicWebApi/）；
# 留空则不启用始发港/到达港的三字码归一化
# DOCMIND_PORT_API_BASE=http://<host>/PublicWebApi/

# 港口主数据本地缓存有效期（小时，默认 7 天）；重拉会连带清空港口归一化结论缓存
# DOCMIND_PORT_CACHE_TTL_HOURS=168.0

# 委托客户主数据接口根地址；留空回退用 DOCMIND_PORT_API_BASE，都为空则停用客户校验
# DOCMIND_CUSTOMER_API_BASE=

# 委托客户主数据本地缓存有效期（小时），过期后按 timestamp 增量更新
# DOCMIND_CUSTOMER_CACHE_TTL_HOURS=24.0

# 港口识别模型调用硬超时（秒）：本地匹配无法定论时才调用模型，
# 超时即放弃归一化、字段转人工审核（避免拖慢 build_result）
# DOCMIND_PORT_MODEL_TIMEOUT_SECONDS=8.0

# ===== 服务启动（main.py 读取） =====
# 业务接口统一前缀（改这里要同步前端 app/static/api.js 与
# app/static/result-dialog/api.js 的接口根路径；/docs、/health、/static 不受影响）
# DOCMIND_API_PREFIX=/docmind

# 监听地址：Docker 部署时由 compose 强制设为 0.0.0.0（容器内 127.0.0.1 外部访问不到）
# DOCMIND_HOST=127.0.0.1

# 监听端口（容器内端口；宿主映射端口用 compose 的 HOST_PORT）
# DOCMIND_PORT=8000

# 是否开启热重载（默认关闭：reload 会中断在途分析任务，改动代码后手动重启即可；
# 调试时显式设 1 开启）
# DOCMIND_RELOAD=0

# ===== 文档渲染 =====
# LibreOffice soffice 可执行路径（DOC/XLS 转 PDF）；留空时自动探测
# DOCMIND_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# 近空白页过滤阈值：非白像素占比低于该值的页面不送 VLM（0 关闭过滤）
# DOCMIND_RENDER_BLANK_PAGE_RATIO=0.005

# 任务产物保留时长（小时）：超过后于服务启动时与每小时自动清理；0 永久保留
# DOCMIND_DATA_RETENTION_HOURS=24.0

# 单文件大小上限（字节，默认 50MB）
# DOCMIND_MAX_FILE_SIZE_BYTES=52428800

# 控制台日志开关（默认只写 logs/app.log；写 stdout 管道可能阻塞事件循环）
# DOCMIND_CONSOLE_LOG=0

# ===== 并发与资源（多用户同时上传时按需调整） =====
# 同时存活的任务数上限（兜底），超出的任务快照保持 queued 排队；
# 默认 20 可覆盖"3 人同时各上传 5 份（15 个任务）"
# DOCMIND_MAX_CONCURRENT_TASKS=20

# 同时进行的 LibreOffice 转换数：每个转换拉起独立 soffice 进程（单实例约
# 200~400MB），建议不超过 CPU 核数；内存吃紧或转换超时时调小到 2~3
# DOCMIND_LO_MAX_CONCURRENT=5

# 同时进行的模型调用数（视觉识别 + 字段抽取）：默认 8 使 15 个任务两批走完
# 模型阶段；上游返回 429 或大面积超时时调小到 3~5
# DOCMIND_MODEL_MAX_CONCURRENT=8
