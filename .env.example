# DocMind 环境配置示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿将真实密钥提交到仓库

# ===== 必需 =====
# DeepSeek API 密钥（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-api-key-here

# ===== 可选（下方为默认值，取消注释即可覆盖） =====
# DeepSeek 接口地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 视觉抽取模型
# DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# 采样温度（抽取场景建议 0.0）
# DEEPSEEK_TEMPERATURE=0.0

# 单次请求超时（秒）
# DEEPSEEK_TIMEOUT_SECONDS=240.0

# 请求失败重试次数
# DEEPSEEK_MAX_RETRIES=1

# 运行数据根目录（上传文件、任务产物、分析结果）
# DOCMIND_DATA_ROOT=data

# ===== 系统日志 =====
# 系统日志文件（应用日志与 Uvicorn 访问日志）
# DOCMIND_SYSTEM_LOG_FILE=logs/app.log

# 系统日志等级
# DOCMIND_SYSTEM_LOG_LEVEL=INFO

# 系统日志按日轮转后的保留天数
# DOCMIND_SYSTEM_LOG_RETENTION_DAYS=14

# ===== 港口三字码归一化 =====
# poOrder PublicWebApi 根地址（如 http://<host>/PublicWebApi/）；
# 留空则不启用始发港/到达港的三字码归一化
# DOCMIND_PORT_API_BASE=http://<host>/PublicWebApi/

# 港口主数据本地缓存有效期（小时）
# DOCMIND_PORT_CACHE_TTL_HOURS=24.0

# ===== 服务启动（main.py 读取） =====
# 监听地址
# DOCMIND_HOST=127.0.0.1

# 监听端口
# DOCMIND_PORT=8001

# 是否开启热重载（1 开启，其他为关闭）
# DOCMIND_RELOAD=1
