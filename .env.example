# DocMind 环境配置（线上 Docker 部署用）
#
# 部署用法：
#   cp .env.example .env && chmod 600 .env
#   vi .env            # 只改下面【必改 1】【必改 2】两处密钥
#   docker compose up -d --build
#
# .env 不进镜像、不入仓库（.gitignore），也不会被 git pull 覆盖，改完只需重建容器。
#
# ═══════════════════════ 替换清单（照这个顺序过一遍） ═══════════════════════
#
# 【必改】1. DEEPSEEK_API_KEY            不填：服务能起，但所有任务报识别失败
# 【必改】2. DOCMIND_FALLBACK_API_KEY    不填：兜底链路整体不生效，主模型一挂全挂
#
# 【必核对】3. DOCMIND_PORT_API_BASE     后端要能访问到；不通 = 港口不归一化成三字码，
#                                        提交时 sfg/mdg 是原文，ERP 大概率拒单
# 【必核对】4. DOCMIND_CORS_ALLOW_ORIGINS 必须列全所有会打开核对面板的来源
# 【必核对】5. DOCMIND_HTTPS_PORT        改端口要同步安全组与 poOrder 的接口基址
#
# 【按机器调】6. 并发三项（默认 20 / 5 / 8 是安全值，别盲目调大）
#
# 【不要填】HOST / PORT / DATA_ROOT / SYSTEM_LOG_FILE：由 docker-compose.yml 的
#           environment 强制注入，写在这里也不生效（compose 优先级高于 env_file）。
# ═════════════════════════════════════════════════════════════════════════════

# ========================= 1. 密钥（必改两处） =========================

# 主模型：DeepSeek（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-api-key-here

# 兜底模型：阿里云百炼 / 通义千问（https://bailian.console.aliyun.com 申请）
# 兜底换的是「另一家上游」，不是主模型的备用副本：DeepSeek 限流 / 欠费 / 宕机时照样出结果。
# 留空 = 整条兜底链路不生效，行为与没加兜底时一致。
DOCMIND_FALLBACK_API_KEY=sk-your-bailian-key-here

# ========================= 2. poOrder 主数据（必核对） =========================

# poOrder PublicWebApi 根地址：港口 / 客户 / 站点 / 项目 / 用户默认设置 / 提交订单 共用。
# 这一项是**服务端**去访问（容器内出站），不是浏览器访问，所以不受 CORS 影响；
# 但必须能从容器里连通，否则港口三字码归一化整体停用。
#
# 优先填内网地址（少绕一圈公网，也更稳）；只能走公网时保持当前写法。
# 结尾的 /PublicWebApi/ 不能删：客户/站点/项目/提交订单的地址都靠它推导。
DOCMIND_PORT_API_BASE=http://erp.wecanintl.com/PublicWebApi/

# ==================== 3. 跨域来源（必核对，最容易踩） ====================

# 调用方（poOrder 的「小凯托书识别」面板）与本服务不同域，浏览器直连本服务，
# 所以必须显式放行。规则很硬：**Origin = 协议 + 域名 + 端口**，一字不差才放行。
#
# 怎么确定该写什么：在 poOrder 里打开核对面板，浏览器控制台执行 location.origin，
# 输出的那个字符串（不含路径、末尾不带 /）就是答案。有多少个入口就写多少个：
#   - https://erp.wecanintl.com     poOrder 线上
#   - https://www.wecanintl.com     官网客服面板
#   - 内网 IP / 裸域 / 其它端口     用哪个就加哪个，例如 https://erp.wecanintl.com:8443
#
# 空值 = 不放行任何跨域（只有同源的内置前端能用）。
# **不要写 ***：接口无鉴权，写 * 等于任何站点都能读走返回内容。
DOCMIND_CORS_ALLOW_ORIGINS=https://www.wecanintl.com,https://erp.wecanintl.com

# ========================= 4. 对外端口（必核对） =========================

# 本服务自带 nginx 容器对外映射的宿主端口。宿主 80/443 已被同机其它站点占用，
# 所以用备用端口，对外地址形如 https://ai.wecanintl.com:8443。
#
# 三处必须一致，缺一处就调不通：
#   1) 这里（宿主端口映射）
#   2) 阿里云安全组入方向放行该端口
#   3) poOrder 前端 src/utils/aiChat/config.js 的 DOCMIND_API_BASE_PROD
DOCMIND_HTTPS_PORT=8443

# ==================== 5. 提交订单开关（poOrder 无需开启） ====================

# poOrder 的「提交订单」是前端直接调自己域的 BoManagementWebApi/api/ExHpoAxpline，
# **不经过本服务**，所以这条链路保持 false 也能正常建单。
# 只有当调用方没有 poOrder 登录态、需要本服务代为提交时才设为 true。
DOCMIND_ORDER_SUBMIT_ENABLED=false

# ========================= 6. 主模型参数（一般不动） =========================

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 视觉抽取模型（DeepSeek V4.1 Flash 的规范 ID）
# DEEPSEEK_MODEL=deepseek-flash
# 采样温度：抽取场景必须 0.0
# DEEPSEEK_TEMPERATURE=0.0
# SDK 单次 HTTP 读超时 / 连接建立超时（秒）
# DEEPSEEK_TIMEOUT_SECONDS=240.0
# DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10.0
# SDK 层重试次数
# DEEPSEEK_MAX_RETRIES=1
# 字段抽取开 thinking：更稳但耗时 8s → 95s；图片识别必须保持 false（开了会漏字、串语言）
# DEEPSEEK_THINKING=true
# DEEPSEEK_VISION_THINKING=false

# —— 墙钟硬超时与重试（防止任务永远卡在「正在解析中」）——
# 阈值按历史 p90/max 留 2 倍余量：VLM 9.4s/26.4s、抽取 8.7s/84.1s
# DOCMIND_MODEL_VISION_TIMEOUT_SECONDS=60.0
# DOCMIND_MODEL_EXTRACT_TIMEOUT_SECONDS=180.0
# DOCMIND_MODEL_CALL_RETRIES=2

# ========================= 7. 兜底模型参数（一般不动） =========================

# DOCMIND_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 字段抽取用模型
# DOCMIND_FALLBACK_MODEL=qwen3.8-flash
# 图片识别用模型：留空回退上面那项；量大时可单独降档
# DOCMIND_FALLBACK_VISION_MODEL=
# 日志与熔断提示里显示的 provider 名
# DOCMIND_FALLBACK_NAME=qwen
# 采样温度 / 读超时 / 连接超时
# DOCMIND_FALLBACK_TEMPERATURE=0.0
# DOCMIND_FALLBACK_TIMEOUT_SECONDS=240.0
# DOCMIND_FALLBACK_CONNECT_TIMEOUT_SECONDS=10.0
# 兜底自己的重试次数：两个都默认 0。兜底已是最后一环，再重试只会把失败耗时翻倍
# DOCMIND_FALLBACK_MAX_RETRIES=0
# DOCMIND_FALLBACK_CALL_RETRIES=0
# 结构化输出方式：**保持 function_calling**，千问的 json_schema(strict) 会大面积漏字段
# DOCMIND_FALLBACK_STRUCTURED_METHOD=function_calling
# 千问思考开关：**保持 0**，开启后耗时翻倍且字段值整体错位
# DOCMIND_FALLBACK_THINKING=0

# —— provider 熔断：主模型连续失败后直接跳过，冷却结束放行一次试探 ——
# DOCMIND_MODEL_FAILOVER_FAILURE_THRESHOLD=3
# DOCMIND_MODEL_FAILOVER_COOLDOWN_SECONDS=90

# ========================= 8. 主数据缓存与派生地址（一般不用配） =========================
# 下面几项留空时全部回退 DOCMIND_PORT_API_BASE（同一服务、不同资源路径），
# 配好第 2 节即可，这里保持注释。

# 港口缓存有效期（小时）：别调小 —— 重拉会连带清空「模型消歧结论」缓存
# DOCMIND_PORT_CACHE_TTL_HOURS=168.0
# 港口识别模型调用硬超时（秒）：超时即转人工审核，不拖慢结果生成
# DOCMIND_PORT_MODEL_TIMEOUT_SECONDS=8.0

# 委托客户（/api/PubFCustom）
# DOCMIND_CUSTOMER_API_BASE=
# DOCMIND_CUSTOMER_CACHE_TTL_HOURS=24.0
# 唯凯站点字典（/api/PubTypeCode?groupid=101）
# DOCMIND_SITE_API_BASE=
# DOCMIND_SITE_CACHE_TTL_HOURS=168.0
# 委托项目（/api/PubCustom）
# DOCMIND_PROJECT_API_BASE=
# DOCMIND_PROJECT_CACHE_TTL_HOURS=12.0
# 用户默认设置（/api/UserTemplet）
# DOCMIND_USER_TEMPLET_API_BASE=
# 缓存分钟数：调大会让「在 poOrder 改了默认站点」更久才生效
# DOCMIND_USER_DEFAULTS_CACHE_TTL_MINUTES=1
# 提交订单（api/ExHpoAxpline，挂在 BoManagementWebApi）：留空自动从 PORT_API_BASE 推导
# DOCMIND_ORDER_API_BASE=

# ========================= 9. 服务与日志 =========================

# 业务接口统一前缀：改这里必须同步改两个前端 api.js 的接口根路径
# DOCMIND_API_PREFIX=/docmind
# 热重载：**线上必须 0**，reload 会中断在途任务
# DOCMIND_RELOAD=0
# 日志等级 / 按日轮转保留天数
# DOCMIND_SYSTEM_LOG_LEVEL=INFO
# DOCMIND_SYSTEM_LOG_RETENTION_DAYS=14
# 控制台日志：**线上保持 0**，stdout 管道不被及时消费会阻塞事件循环
# DOCMIND_CONSOLE_LOG=0

# ========================= 10. 渲染与并发 =========================

# LibreOffice 路径：镜像内已装，留空自动探测
# DOCMIND_SOFFICE_PATH=
# 近空白页过滤阈值：非白像素占比低于它不送 VLM（0 关闭）
# DOCMIND_RENDER_BLANK_PAGE_RATIO=0.005
# 任务产物保留时长（小时）：0 = 永久保留
# DOCMIND_DATA_RETENTION_HOURS=24.0
# 单文件上限（字节）：改大必须同步改 deploy/nginx/docmind.conf 的 client_max_body_size，
# 否则先被 nginx 挡成 413
# DOCMIND_MAX_FILE_SIZE_BYTES=52428800

# —— 并发（默认值即安全值；只有确认 CPU 核数与内存后才调大）——
# 同时存活任务上限：默认 20 覆盖「3 人各传 5 份」
# DOCMIND_MAX_CONCURRENT_TASKS=20
# LibreOffice 并发：每个 soffice 占 200~400MB，**不要超过 CPU 核数**，
# 建议留一半核给光栅化与 Web；内存吃紧或转换超时调到 2~3
# DOCMIND_LO_MAX_CONCURRENT=5
# 模型并发（纯网络等待，瓶颈在上游限流）：429 或大面积超时调到 3~5
# DOCMIND_MODEL_MAX_CONCURRENT=8

# ========================= 11. 票据 =========================

# ?ticket= 兜底通道：**线上保持 0**。票据进 URL 会跟着进浏览器历史、Referer 与网关日志。
# 正常通道是请求头 Authorization / X-PoOrder-Ticket，由调用方携带，本服务只透传。
# DOCMIND_ALLOW_URL_TICKET=0

# ========================= 12. docker compose 构建参数 =========================

# 容器时区（影响日志时间戳与任务 ID 里的时间部分）
# TZ=Asia/Shanghai

# 宿主调试端口：只绑 127.0.0.1，给 curl /health 与 SSH 隧道看内置前端用，
# 线上流量不经过它。改了要同步 SSH 隧道命令。
# HOST_PORT=8000

# 国内服务器：替换 Debian 软件源，否则 apt-get update 可能卡到构建超时
APT_MIRROR=mirrors.aliyun.com

# 境外服务器：uv.lock 里的清华源可能访问不了，改用官方 PyPI
# UV_INDEX_URL=https://pypi.org/simple

# ═════════════════════════════ 生效与自检 ═════════════════════════════
#
# 改了 .env 必须重建容器（compose 不一定识别环境变量变化）：
#   docker compose up -d --force-recreate
# 改过代码或 Dockerfile 才需要：
#   git pull && docker compose up -d --build
#
# 依次验证（前一步不通就不用看后一步）：
#   curl -sk https://127.0.0.1:8443/health                 # {"status":"ok"}
#   curl -s  https://ai.wecanintl.com:8443/health          # 外网可达（不通=安全组）
#   docker compose exec docmind python -c \
#     "import httpx,os;b=os.environ['DOCMIND_PORT_API_BASE'];print(httpx.get(b+'api/PubAirPortArea',timeout=30).status_code)"
#                                                          # 出站主数据连通性（期望 200）
#   docker compose exec docmind grep -E "provider 链|港口" /app/logs/app.log | tail -5
#                                                          # 启动日志里应看到 deepseek/... -> qwen/...
#
# 浏览器侧（在 poOrder 页面控制台执行，验证 CORS）：
#   fetch('https://ai.wecanintl.com:8443/docmind/analysis/ports?keyword=shanghai')
#     .then(r=>r.json()).then(console.log)                 # 返回 {items:[...]} 即通过
